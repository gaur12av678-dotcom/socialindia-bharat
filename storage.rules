rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Video uploads: max 100MB (104857600 bytes), must be video/ content type
    match /videos/{allPaths=**} {
      allow read: if true;
      allow write: if true;
    }

    // Thumbnail uploads: max 10MB
    match /thumbnails/{allPaths=**} {
      allow read: if true;
      allow write: if true;
    }

    // Community Post media uploads (photos and videos)
    match /posts/{allPaths=**} {
      allow read: if true;
      allow write: if true;
    }

    // Avatar / Profile uploads: max 5MB (5242880 bytes), must be image/ content type
    match /avatars/{allPaths=**} {
      allow read: if true;
      allow write: if true;
    }

    // Default deny catch-all for everything else
    match /{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }
  }
}
