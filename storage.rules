rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function validImage(maxBytes) {
      return request.resource != null &&
        request.resource.size <= maxBytes &&
        request.resource.contentType.matches('image/.*');
    }

    function validVideo(maxBytes) {
      return request.resource != null &&
        request.resource.size <= maxBytes &&
        request.resource.contentType.matches('video/.*');
    }

    // Existing media remains publicly readable. New uploads must be stored
    // beneath the authenticated owner's UID.
    match /videos/{uid}/{allPaths=**} {
      allow read: if true;
      allow create, update: if isOwner(uid) && validVideo(104857600);
      allow delete: if isOwner(uid);
    }

    match /thumbnails/{uid}/{allPaths=**} {
      allow read: if true;
      allow create, update: if isOwner(uid) && validImage(10485760);
      allow delete: if isOwner(uid);
    }

    match /posts/{uid}/{allPaths=**} {
      allow read: if true;
      allow create, update: if isOwner(uid) && request.resource != null &&
        request.resource.size <= 104857600 &&
        (request.resource.contentType.matches('image/.*') ||
         request.resource.contentType.matches('video/.*'));
      allow delete: if isOwner(uid);
    }

    match /avatars/{uid}/{allPaths=**} {
      allow read: if true;
      allow create, update: if isOwner(uid) && validImage(5242880);
      allow delete: if isOwner(uid);
    }

    // Keep legacy media readable, but never allow new unscoped uploads.
    match /{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }
  }
}