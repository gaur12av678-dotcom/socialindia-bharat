rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {


match /adminSettings/{docId} {
      // Public configuration/feed documents remain readable; only admins may change them.
      allow read: if true;
      allow write: if isAdmin();
    }

    // Default deny catch-all safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isSignedIn() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // --- USERS COLLECTION ---
    match /users/{uid} {
      // Public profile fields can be read by anyone
      allow read: if true;
      
      // Initial registration profile write
      allow create: if isOwner(uid) && 
        request.resource.data.role == 'user';

      // Update allowed by owner (protecting role and status), admin, or wallet/bonus balance/follower updates
      allow update: if (isOwner(uid) &&
        !(request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'status']))) || isAdmin() ||
        (isSignedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'followersCount', 'followingCount', 'videosCount', 'updatedAt'
        ]));

      // Only admins can delete profiles
      allow delete: if isAdmin();

      // Isolated nested private settings collection
      match /private/{docId} {
        allow read, write: if isOwner(uid);
      }

      // User subscriptions subcollection
      match /subscriptions/{creatorId} {
        allow read, write, delete: if isSignedIn();
      }

      // User saved videos (watch later) subcollection
      match /savedVideos/{videoId} {
        allow read, write, delete: if isOwner(uid);
      }

      // User liked videos subcollection
      match /likedVideos/{videoId} {
        allow read, write, delete: if isOwner(uid);
      }

      // User watch history subcollection
      match /history/{videoId} {
        allow read, write, delete: if isOwner(uid);
      }

      // User notifications subcollection
      match /notifications/{notifId} {
        allow read, update, delete: if isOwner(uid);
        allow create: if isSignedIn();
      }
    }

    // --- WITHDRAWAL / PAYOUT REQUESTS COLLECTION ---
    match /withdrawal_requests/{requestId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // --- VIDEOS COLLECTION ---
    match /videos/{videoId} {
      allow read: if true;
      
      allow create: if isSignedIn() && 
        request.resource.data.creatorId == request.auth.uid;
        
      allow update: if isSignedIn() && (
        resource.data.creatorId == request.auth.uid ||
        isAdmin() ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'viewsCount', 'likesCount', 'commentsCount', 'sharesCount'
        ])
      );

      allow delete: if isSignedIn() && (
        resource.data.creatorId == request.auth.uid || 
        isAdmin()
      );

      // Video comments subcollection
      match /comments/{commentId} {
        allow read: if true;
        allow create: if isSignedIn() && (request.resource.data.uid == request.auth.uid || request.resource.data.userId == request.auth.uid);
        allow update: if isSignedIn() && (
          ((resource.data.uid == request.auth.uid || resource.data.userId == request.auth.uid) &&
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['uid', 'userId', 'videoId', 'commentId', 'createdAt'])) ||
          ((isAdmin() || get(/databases/$(database)/documents/videos/$(videoId)).data.creatorId == request.auth.uid) &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hasCreatorHeart', 'heartedAt', 'isPinned', 'pinnedAt', 'updatedAt']))
        );
        allow delete: if isSignedIn() && (
          resource.data.uid == request.auth.uid || 
          resource.data.userId == request.auth.uid || 
          get(/databases/$(database)/documents/videos/$(videoId)).data.creatorId == request.auth.uid ||
          isAdmin()
        );

        // Comment likes subcollection
        match /likes/{userId} {
          allow read: if true;
          allow create: if isSignedIn() && userId == request.auth.uid;
          allow delete: if isSignedIn() && userId == request.auth.uid;
        }

        // Comment dislikes subcollection
        match /dislikes/{userId} {
          allow read: if true;
          allow create: if isSignedIn() && userId == request.auth.uid;
          allow delete: if isSignedIn() && userId == request.auth.uid;
        }
      }

      // Video likes subcollection
      match /likes/{userId} {
        allow read: if true;
        allow create: if isSignedIn() && userId == request.auth.uid;
        allow delete: if isSignedIn() && userId == request.auth.uid;
      }
    }

    // --- VIDEO PURCHASES COLLECTION ---
    match /video_purchases/{purchaseId} {
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid || 
        resource.data.creatorId == request.auth.uid || 
        isAdmin()
      );
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // --- WALLET TRANSACTIONS COLLECTION ---
    match /wallet_transactions/{txId} {
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // --- COMMENTS COLLECTION ---
    match /comments/{commentId} {
      allow read: if true;
      allow create: if isSignedIn() && (request.resource.data.userId == request.auth.uid || request.resource.data.uid == request.auth.uid);
      allow update, delete: if isSignedIn() && (
        resource.data.userId == request.auth.uid || resource.data.uid == request.auth.uid || isAdmin()
      );
    }

    // --- LIKES COLLECTION ---
    match /likes/{likeId} {
      allow read: if true;
      allow create: if isSignedIn() && (request.resource.data.userId == request.auth.uid || request.resource.data.uid == request.auth.uid);
      allow delete: if isSignedIn() && (
        resource.data.userId == request.auth.uid || resource.data.uid == request.auth.uid || isAdmin()
      );
    }

    // --- REPORTS COLLECTION ---
    match /reports/{reportId} {
      allow create: if isSignedIn();
      allow read, update, delete: if isAdmin() || (isSignedIn() && resource.data.reporterId == request.auth.uid);
    }

    // --- GRIEVANCES & IT RULES COMPLAINTS COLLECTION ---
    match /grievances/{grievanceId} {
      allow create: if true;
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // --- CONTENT & ACCOUNT APPEALS COLLECTION ---
    match /appeals/{appealId} {
      allow create: if isSignedIn();
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // --- FEEDBACK COLLECTION ---
    match /feedback/{feedbackId} {
      allow create: if isSignedIn();
      allow read, update, delete: if isAdmin();
    }

    // --- SYSTEM SETTINGS COLLECTION ---
    match /system_settings/{settingId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // --- SOUNDS LIBRARY COLLECTION ---
    match /sounds/{soundId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.creatorUid == request.auth.uid;
      allow update, delete: if isAdmin() || (isSignedIn() && resource.data.creatorUid == request.auth.uid);
    }

    // --- TRASH VAULT COLLECTION ---
    match /trash/{trashId} {
      allow read, write: if isAdmin();
    }

    // --- AD CAMPAIGNS COLLECTION ---
    match /ad_campaigns/{adId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (
        resource.data.creatorUid == request.auth.uid ||
        resource.data.userId == request.auth.uid ||
        isAdmin() ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['impressions', 'clicks', 'results', 'updatedAt'])
      );
      allow delete: if isSignedIn() && (
        resource.data.creatorUid == request.auth.uid || 
        resource.data.userId == request.auth.uid || 
        isAdmin()
      );
    }

    // --- CHATS & MESSAGES COLLECTIONS ---
    match /conversations/{convId} {
      allow read, write: if isSignedIn();
      
      match /messages/{msgId} {
        allow read, write: if isSignedIn();
      }
    }

    match /chats/{chatId} {
      allow read, write: if isSignedIn();
    }

    // --- PLAYLISTS & SOUND TRACKS ---
    match /playlists/{playlistId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /sound_tracks/{trackId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // --- COMMUNITY POSTS & POLLS COLLECTION ---
    match /posts/{postId} {
      allow read: if true;
      allow create: if isSignedIn() &&
        request.resource.data.authorId == request.auth.uid &&
        request.resource.data.postId == postId &&
        request.resource.data.keys().hasAll(['authorId', 'postId', 'content', 'createdAt']);
      allow update: if isAdmin() ||
        (isSignedIn() && resource.data.authorId == request.auth.uid &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['authorId', 'postId', 'createdAt'])) ||
        (isSignedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likesCount', 'dislikesCount', 'commentsCount', 'sharesCount', 'poll', 'updatedAt']));
      allow delete: if isAdmin() || (isSignedIn() && resource.data.authorId == request.auth.uid);

      match /comments/{commentId} {
        allow read: if true;
        allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid &&
          request.resource.data.postId == postId;
        allow update: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['uid', 'postId', 'commentId', 'createdAt']));
        allow delete: if isAdmin() || (isSignedIn() && (
          resource.data.uid == request.auth.uid ||
          get(/databases/$(database)/documents/posts/$(postId)).data.authorId == request.auth.uid
        ));
      }
    }

    // --- NOTIFICATIONS COLLECTION ---
    match /notifications/{notifId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }
  }
}
