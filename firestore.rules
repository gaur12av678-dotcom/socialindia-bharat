rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {


match /adminSettings/{docId} {
  allow read: if true;
  allow write: if request.auth != null;
}

    // Default deny catch-all safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isSignedIn() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // --- USERS COLLECTION ---
    match /users/{uid} {
      // Public profile fields can be read by anyone
      allow read: if true;
      
      // Initial registration profile write
      allow create: if isOwner(uid) && 
        request.resource.data.role == 'user';

      // Update allowed by owner (protecting role and status), admin, or wallet/bonus balance/follower updates
      allow update: if (isOwner(uid) && 
        !(request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'role', 'status'
        ]))) || isAdmin() || (
          isSignedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'walletBalance', 'mainBalance', 'bonusBalance', 'isMonetized', 'monetizationStatus', 'points', 'upiId', 'updatedAt', 'followersCount', 'followingCount'
          ])
        );

      // Only admins can delete profiles
      allow delete: if isAdmin();

      // Isolated nested private settings collection
      match /private/{docId} {
        allow read, write: if isOwner(uid);
      }

      // User subscriptions subcollection
      match /subscriptions/{creatorId} {
        allow read, write, delete: if isSignedIn();
      }

      // User saved videos (watch later) subcollection
      match /savedVideos/{videoId} {
        allow read, write, delete: if isOwner(uid);
      }

      // User watch history subcollection
      match /history/{videoId} {
        allow read, write, delete: if isOwner(uid);
      }

      // User notifications subcollection
      match /notifications/{notifId} {
        allow read, update, delete: if isOwner(uid);
        allow create: if isSignedIn();
      }
    }

    // --- WITHDRAWAL / PAYOUT REQUESTS COLLECTION ---
    match /withdrawal_requests/{requestId} {
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // --- VIDEOS COLLECTION ---
    match /videos/{videoId} {
      allow read: if true;
      
      allow create: if isSignedIn() && 
        request.resource.data.creatorId == request.auth.uid;
        
      allow update, delete: if isSignedIn() && (
        resource.data.creatorId == request.auth.uid || 
        isAdmin() ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'viewsCount', 'likesCount', 'commentsCount', 'sharesCount', 'paidSalesCount', 'paidEarnings'
        ])
      );

      // Video comments subcollection
      match /comments/{commentId} {
        allow read: if true;
        allow create: if isSignedIn();
        allow update: if isSignedIn() && (
          resource.data.uid == request.auth.uid || 
          resource.data.userId == request.auth.uid || 
          isAdmin() ||
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'likesCount', 'isPinned', 'pinnedAt', 'text', 'updatedAt'
          ])
        );
        allow delete: if isSignedIn() && (
          resource.data.uid == request.auth.uid || 
          resource.data.userId == request.auth.uid || 
          isAdmin()
        );
      }

      // Video likes subcollection
      match /likes/{userId} {
        allow read: if true;
        allow create, delete: if isSignedIn();
      }
    }

    // --- VIDEO PURCHASES COLLECTION ---
    match /video_purchases/{purchaseId} {
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid || 
        resource.data.creatorId == request.auth.uid || 
        isAdmin()
      );
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // --- WALLET TRANSACTIONS COLLECTION ---
    match /wallet_transactions/{txId} {
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    // --- COMMENTS COLLECTION ---
    match /comments/{commentId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );
    }

    // --- LIKES COLLECTION ---
    match /likes/{likeId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow delete: if isSignedIn() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );
    }

    // --- REPORTS COLLECTION ---
    match /reports/{reportId} {
      allow create: if isSignedIn();
      allow read, update, delete: if isAdmin() || (isSignedIn() && resource.data.reporterId == request.auth.uid);
    }

    // --- GRIEVANCES & IT RULES COMPLAINTS COLLECTION ---
    match /grievances/{grievanceId} {
      allow create: if true;
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // --- CONTENT & ACCOUNT APPEALS COLLECTION ---
    match /appeals/{appealId} {
      allow create: if isSignedIn();
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // --- FEEDBACK COLLECTION ---
    match /feedback/{feedbackId} {
      allow create: if isSignedIn();
      allow read, update, delete: if isAdmin();
    }

    // --- SYSTEM SETTINGS COLLECTION ---
    match /system_settings/{settingId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // --- SOUNDS LIBRARY COLLECTION ---
    match /sounds/{soundId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // --- TRASH VAULT COLLECTION ---
    match /trash/{trashId} {
      allow read, write: if isAdmin();
    }

    // --- AD CAMPAIGNS COLLECTION ---
    match /ad_campaigns/{adId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update: if (isSignedIn() && (
        resource.data.creatorUid == request.auth.uid || 
        resource.data.userId == request.auth.uid || 
        isAdmin() ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'impressions', 'clicks', 'results', 'spent', 'updatedAt'
        ])
      )) || (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'impressions', 'clicks', 'results', 'spent', 'updatedAt'
        ])
      );
      allow delete: if isSignedIn() && (
        resource.data.creatorUid == request.auth.uid || 
        resource.data.userId == request.auth.uid || 
        isAdmin()
      );
    }

    // --- CHATS & MESSAGES COLLECTIONS ---
    match /conversations/{convId} {
      allow read, write: if isSignedIn();
      
      match /messages/{msgId} {
        allow read, write: if isSignedIn();
      }
    }

    match /chats/{chatId} {
      allow read, write: if isSignedIn();
    }

    // --- PLAYLISTS & SOUND TRACKS ---
    match /playlists/{playlistId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /sound_tracks/{trackId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // --- NOTIFICATIONS COLLECTION ---
    match /notifications/{notifId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }
  }
}
