rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Primitive Helpers
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isUserVerified() {
      return isSignedIn(); // Support general login
    }

    // ----------------- USERS COLLECTION -----------------
    match /users/{uid} {
      allow read: if true; // Public profiles are searchable/viewable

      // For user profiles, only owners can create or edit
      allow create: if isSignedIn() 
                    && isOwner(uid) 
                    && isValidId(uid)
                    && incoming().uid == uid
                    && incoming().username is string
                    && incoming().username.size() >= 3
                    && incoming().username.size() <= 30
                    && incoming().username.matches('^[a-zA-Z0-9_]+$')
                    && incoming().displayName is string
                    && incoming().displayName.size() >= 1
                    && incoming().displayName.size() <= 50
                    && incoming().followersCount == 0
                    && incoming().followingCount == 0
                    && incoming().videosCount == 0
                    && (incoming().role == 'user' || incoming().role == 'creator')
                    && incoming().status == 'active'
                    && incoming().createdAt == request.time
                    && incoming().updatedAt == request.time;

      allow update: if isSignedIn() 
                    && (
                      // Case A: Owner edits their profile details (displayName, bio, photoURL, updatedAt)
                      (isOwner(uid) 
                       && incoming().uid == existing().uid
                       && incoming().username == existing().username
                       && incoming().role == existing().role
                       && incoming().status == existing().status
                       && incoming().createdAt == existing().createdAt
                       && incoming().updatedAt == request.time
                       && incoming().displayName is string
                       && incoming().displayName.size() >= 1
                       && incoming().displayName.size() <= 50
                       && (incoming().bio == null || (incoming().bio is string && incoming().bio.size() <= 160))
                       && (incoming().photoURL == null || incoming().photoURL is string)
                       && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'bio', 'photoURL', 'updatedAt', 'followersCount', 'followingCount', 'videosCount']))
                      ||
                      // Case B: Social interactions incrementing counts (followers, following, videos) safely
                      (incoming().uid == existing().uid
                       && incoming().username == existing().username
                       && incoming().displayName == existing().displayName
                       && incoming().bio == existing().bio
                       && incoming().photoURL == existing().photoURL
                       && incoming().role == existing().role
                       && incoming().status == existing().status
                       && incoming().createdAt == existing().createdAt
                       && incoming().updatedAt == request.time
                       && incoming().diff(existing()).affectedKeys().hasOnly(['followersCount', 'followingCount', 'videosCount', 'updatedAt']))
                    );

      allow delete: if false; // Profiles cannot be directly deleted by clients

      // --- Private user subcollection for isolated settings and PII ---
      match /private/info {
        allow read, write: if isSignedIn() && isOwner(uid);
      }
      
      // --- Notifications subcollection ---
      match /notifications/{notificationId} {
        allow read: if isSignedIn() && isOwner(uid);
        allow create: if isSignedIn() 
                      && isValidId(notificationId)
                      && incoming().notificationId == notificationId
                      && incoming().recipientId == uid
                      && incoming().actorId == request.auth.uid
                      && incoming().read == false
                      && incoming().createdAt == request.time;
        allow update: if isSignedIn() 
                      && isOwner(uid)
                      && incoming().recipientId == existing().recipientId
                      && incoming().actorId == existing().actorId
                      && incoming().createdAt == existing().createdAt
                      && incoming().diff(existing()).affectedKeys().hasOnly(['read']);
        allow delete: if isSignedIn() && isOwner(uid);
      }

      // --- Subscriptions subcollection ---
      match /subscriptions/{creatorId} {
        allow read: if true; // Subscriptions can be read to show follow status
        allow create: if isSignedIn() 
                      && isOwner(uid)
                      && isValidId(creatorId)
                      && incoming().subscriberId == uid
                      && incoming().creatorId == creatorId
                      && incoming().createdAt == request.time;
        allow delete: if isSignedIn() && isOwner(uid);
      }

      // --- Watch History subcollection ---
      match /history/{videoId} {
        allow read, write: if isSignedIn() && isOwner(uid) && isValidId(videoId);
      }

      // --- Saved Videos subcollection ---
      match /savedVideos/{videoId} {
        allow read, write: if isSignedIn() && isOwner(uid) && isValidId(videoId);
      }
    }

    // ----------------- VIDEOS COLLECTION -----------------
    match /videos/{videoId} {
      allow read: if resource.data.visibility == 'public' 
                  || resource.data.visibility == 'unlisted' 
                  || (isSignedIn() && resource.data.creatorId == request.auth.uid);

      allow create: if isSignedIn() 
                    && isValidId(videoId)
                    && incoming().videoId == videoId
                    && incoming().creatorId == request.auth.uid
                    && incoming().title is string
                    && incoming().title.size() >= 3
                    && incoming().title.size() <= 100
                    && incoming().videoUrl is string
                    && incoming().videoUrl.size() <= 1000
                    && incoming().videoUrl.matches('^https://.+')
                    && incoming().visibility in ['public', 'unlisted', 'private']
                    && incoming().status == 'published'
                    && incoming().viewsCount == 0
                    && incoming().likesCount == 0
                    && incoming().commentsCount == 0
                    && incoming().sharesCount == 0
                    && incoming().createdAt == request.time
                    && incoming().updatedAt == request.time;

      allow update: if isSignedIn() 
                    && (
                      // Case A: Creator edits their video details
                      (incoming().creatorId == request.auth.uid 
                       && existing().creatorId == request.auth.uid
                       && incoming().videoId == existing().videoId
                       && incoming().videoUrl == existing().videoUrl
                       && incoming().createdAt == existing().createdAt
                       && incoming().updatedAt == request.time
                       && incoming().title is string
                       && incoming().title.size() >= 3
                       && incoming().title.size() <= 100
                       && incoming().visibility in ['public', 'unlisted', 'private']
                       && incoming().status in ['published', 'processing', 'hidden', 'removed']
                       && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'description', 'thumbnailUrl', 'category', 'tags', 'visibility', 'status', 'updatedAt']))
                      ||
                      // Case B: Social counters increment (viewsCount, likesCount, commentsCount, sharesCount)
                      (incoming().creatorId == existing().creatorId
                       && incoming().videoId == existing().videoId
                       && incoming().videoUrl == existing().videoUrl
                       && incoming().title == existing().title
                       && incoming().visibility == existing().visibility
                       && incoming().status == existing().status
                       && incoming().createdAt == existing().createdAt
                       && incoming().updatedAt == request.time
                       && incoming().diff(existing()).affectedKeys().hasOnly(['viewsCount', 'likesCount', 'commentsCount', 'sharesCount', 'updatedAt']))
                    );

      allow delete: if isSignedIn() && existing().creatorId == request.auth.uid;

      // --- Comments Subcollection (Master Gate pattern) ---
      match /comments/{commentId} {
        allow read: if true; // Public comments viewable
        allow create: if isSignedIn()
                      && isValidId(commentId)
                      && exists(/databases/$(database)/documents/videos/$(videoId))
                      && incoming().commentId == commentId
                      && incoming().videoId == videoId
                      && incoming().uid == request.auth.uid
                      && incoming().text is string
                      && incoming().text.size() >= 1
                      && incoming().text.size() <= 1000
                      && incoming().likesCount == 0
                      && incoming().createdAt == request.time
                      && incoming().updatedAt == request.time;

        allow update: if isSignedIn()
                      && incoming().uid == request.auth.uid
                      && existing().uid == request.auth.uid
                      && incoming().commentId == existing().commentId
                      && incoming().videoId == existing().videoId
                      && incoming().createdAt == existing().createdAt
                      && incoming().updatedAt == request.time
                      && incoming().text is string
                      && incoming().text.size() >= 1
                      && incoming().text.size() <= 1000
                      && incoming().diff(existing()).affectedKeys().hasOnly(['text', 'updatedAt', 'likesCount']);

        allow delete: if isSignedIn() && (existing().uid == request.auth.uid || get(/databases/$(database)/documents/videos/$(videoId)).data.creatorId == request.auth.uid);
      }

      // --- Likes Subcollection (Master Gate pattern) ---
      match /likes/{uid} {
        allow read: if true;
        allow create: if isSignedIn()
                      && isOwner(uid)
                      && exists(/databases/$(database)/documents/videos/$(videoId))
                      && incoming().uid == uid
                      && incoming().videoId == videoId
                      && incoming().createdAt == request.time;
        allow delete: if isSignedIn() && isOwner(uid);
      }
    }

    // ----------------- REPORTS COLLECTION -----------------
    match /reports/{reportId} {
      allow read: if isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
      allow create: if isSignedIn()
                    && isValidId(reportId)
                    && incoming().reportId == reportId
                    && incoming().reporterId == request.auth.uid
                    && incoming().targetType in ['video', 'comment', 'creator']
                    && incoming().targetId is string
                    && incoming().reason in ['spam', 'misleading', 'harassment', 'copyright', 'inappropriate', 'other']
                    && incoming().status == 'pending'
                    && incoming().createdAt == request.time;
      allow update: if isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
      allow delete: if false;
    }
  }
}
