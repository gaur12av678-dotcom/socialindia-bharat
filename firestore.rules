rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {


match /adminSettings/{docId} {
  allow read: if true;
  allow write: if request.auth != null;
}

    // Default deny catch-all safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isSignedIn() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Let signed-in users restore their video-like history across devices.
    match /{path=**}/likes/{likeId} {
      allow read: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    // --- USERS COLLECTION ---
    match /users/{uid} {
      // Public profile fields can be read by anyone
      allow read: if true;
      
      // Initial registration profile write
      allow create: if isOwner(uid) && 
        request.resource.data.role == 'user';

      // Update allowed by owner (protecting role and status), admin, or wallet/bonus balance/follower updates
      allow update: if (isOwner(uid) && 
        !(request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'role', 'status'
        ]))) || isAdmin() || (
          isSignedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'walletBalance', 'mainBalance', 'bonusBalance', 'isMonetized', 'monetizationStatus', 'points', 'upiId', 'updatedAt', 'followersCount', 'followingCount'
          ])
        );

      // Only admins can delete profiles
      allow delete: if isAdmin();

      // Isolated nested private settings collection
      match /private/{docId} {
        allow read, write: if isOwner(uid);
      }

      // User subscriptions subcollection
      match /subscriptions/{creatorId} {
        allow read, write, delete: if isSignedIn();
      }

      // User saved videos (watch later) subcollection
      match /savedVideos/{videoId} {
        allow read, write, delete: if isOwner(uid);
      }

      // User liked videos subcollection
      match /likedVideos/{videoId} {
        allow read, write, delete: if isOwner(uid);
      }

      // User watch history subcollection
      match /history/{videoId} {
        allow read, write, delete: if isOwner(uid);
      }

      // User notifications subcollection
      match /notifications/{notifId} {
        allow read, update, delete: if isOwner(uid);
        allow create: if isSignedIn();
      }
    }

    // --- WITHDRAWAL / PAYOUT REQUESTS COLLECTION ---
    match /withdrawal_requests/{requestId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isSignedIn();
    }

    // --- VERIFICATION REQUESTS COLLECTION ---
    match /verification_requests/{requestId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isSignedIn();
    }

    // --- VIDEOS COLLECTION ---
    match /videos/{videoId} {
      allow get: if resource.data.get('visibility', 'public') in ['public', 'unlisted'] ||
        (isSignedIn() && resource.data.creatorId == request.auth.uid);
      allow list: if resource.data.get('visibility', 'public') == 'public' ||
        (isSignedIn() && resource.data.creatorId == request.auth.uid);
      
      allow create: if isSignedIn() && 
        request.resource.data.creatorId == request.auth.uid;
        
      allow update: if (isSignedIn() && (
        resource.data.creatorId == request.auth.uid || 
        isAdmin() ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'viewsCount', 'likesCount', 'commentsCount', 'sharesCount', 'paidSalesCount', 'paidEarnings'
        ])
      )) || (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'viewsCount', 'sharesCount'
        ])
      );

      allow delete: if isSignedIn() && (
        resource.data.creatorId == request.auth.uid || 
        isAdmin()
      );

      // Video comments subcollection
      match /comments/{commentId} {
        allow read: if get(/databases/$(database)/documents/videos/$(videoId)).data.get('commentsMode', 'allow') != 'disabled' &&
          (resource.data.get('status', 'published') == 'published' ||
           (isSignedIn() && get(/databases/$(database)/documents/videos/$(videoId)).data.creatorId == request.auth.uid));
        allow create: if isSignedIn() &&
          request.resource.data.uid == request.auth.uid &&
          get(/databases/$(database)/documents/videos/$(videoId)).data.get('commentsMode', 'allow') != 'disabled' &&
          request.resource.data.get('status', 'published') ==
            (get(/databases/$(database)/documents/videos/$(videoId)).data.get('commentsMode', 'allow') == 'hold' ? 'pending' : 'published');
        allow update: if isSignedIn() && (
          isAdmin() ||
          ((resource.data.uid == request.auth.uid || resource.data.userId == request.auth.uid) &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'updatedAt'])) ||
          (get(/databases/$(database)/documents/videos/$(videoId)).data.creatorId == request.auth.uid &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status', 'updatedAt', 'hasCreatorHeart', 'heartedAt', 'isPinned', 'pinnedAt'
            ])) ||
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likesCount', 'dislikesCount'])
        );
        allow delete: if isSignedIn() && (
          resource.data.uid == request.auth.uid || 
          resource.data.userId == request.auth.uid || 
          get(/databases/$(database)/documents/videos/$(videoId)).data.creatorId == request.auth.uid ||
          isAdmin()
        );

        // Comment likes subcollection
        match /likes/{userId} {
          allow read: if true;
          allow write: if isSignedIn();
        }

        // Comment dislikes subcollection
        match /dislikes/{userId} {
          allow read: if true;
          allow write: if isSignedIn();
        }
      }

      // Video likes subcollection
      match /likes/{userId} {
        allow read: if true;
        allow write: if isSignedIn();
      }
    }

    // --- VIDEO PURCHASES COLLECTION ---
    match /video_purchases/{purchaseId} {
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid || 
        resource.data.creatorId == request.auth.uid || 
        isAdmin()
      );
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // --- WALLET TRANSACTIONS COLLECTION ---
    match /wallet_transactions/{txId} {
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    // --- COMMENTS COLLECTION ---
    match /comments/{commentId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );
    }

    // --- LIKES COLLECTION ---
    match /likes/{likeId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow delete: if isSignedIn() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );
    }

    // --- REPORTS COLLECTION ---
    match /reports/{reportId} {
      allow create: if isSignedIn();
      allow read, update, delete: if isAdmin() || (isSignedIn() && resource.data.reporterId == request.auth.uid);
    }

    // --- PRIVATE GRIEVANCE SUBMISSIONS ---
    match /grievances/{grievanceId} {
      allow create: if
        request.resource.data.keys().hasOnly([
          'trackingId', 'complainantName', 'email', 'category', 'targetUrl',
          'emergency', 'description', 'evidenceReference', 'submittedAt',
          'status', 'adminNotes', 'resolutionDetails', 'updatedAt'
        ]) &&
        request.resource.data.keys().hasAll([
          'trackingId', 'complainantName', 'email', 'category', 'targetUrl',
          'emergency', 'description', 'evidenceReference', 'submittedAt',
          'status', 'adminNotes', 'resolutionDetails', 'updatedAt'
        ]) &&
        request.resource.data.trackingId is string &&
        request.resource.data.trackingId == 'SI-' + grievanceId &&
        request.resource.data.trackingId.size() <= 80 &&
        request.resource.data.complainantName is string &&
        request.resource.data.complainantName.size() >= 1 &&
        request.resource.data.complainantName.size() <= 120 &&
        request.resource.data.email is string &&
        request.resource.data.email.size() <= 254 &&
        request.resource.data.email.matches('^[^@ ]+@[^@ ]+\\.[^@ ]+$') &&
        request.resource.data.category in [
          'Copyright Infringement',
          'Privacy Violation / Personal Data Exposure',
          'Child Safety Concern',
          'Impersonation / Identity Theft',
          'Cyberbullying / Harassment',
          'Threatening or Illegal Content',
          'Account-Related Complaint',
          'Other Grievance'
        ] &&
        request.resource.data.targetUrl is string &&
        request.resource.data.targetUrl.size() <= 2048 &&
        (request.resource.data.targetUrl == '' ||
          request.resource.data.targetUrl.matches('^https?://.+')) &&
        request.resource.data.emergency is bool &&
        request.resource.data.description is string &&
        request.resource.data.description.size() >= 10 &&
        request.resource.data.description.size() <= 10000 &&
        request.resource.data.evidenceReference is string &&
        request.resource.data.evidenceReference.size() <= 2048 &&
        (request.resource.data.evidenceReference == '' ||
          request.resource.data.evidenceReference.matches('^https?://.+')) &&
        request.resource.data.submittedAt is timestamp &&
        request.resource.data.status == 'new' &&
        request.resource.data.adminNotes == '' &&
        request.resource.data.resolutionDetails == '' &&
        request.resource.data.updatedAt is timestamp;
      allow read: if isAdmin();
      allow update: if isAdmin() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'adminNotes', 'resolutionDetails', 'updatedAt'
        ]) &&
        request.resource.data.status in [
          'new', 'pending', 'under_review', 'action_taken', 'resolved', 'rejected'
        ] &&
        request.resource.data.adminNotes is string &&
        request.resource.data.adminNotes.size() <= 5000 &&
        request.resource.data.resolutionDetails is string &&
        request.resource.data.resolutionDetails.size() <= 5000 &&
        request.resource.data.updatedAt is timestamp;
      allow delete: if false;

      match /history/{historyId} {
        allow read: if isAdmin();
        allow create: if isAdmin() &&
          request.resource.data.adminUid == request.auth.uid &&
          request.resource.data.trackingId is string &&
          request.resource.data.action in ['status_updated', 'admin_note_updated'] &&
          request.resource.data.createdAt is timestamp;
        allow update, delete: if false;
      }
    }

    // --- CONTENT & ACCOUNT APPEALS COLLECTION ---
    match /appeals/{appealId} {
      allow create: if isSignedIn();
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // --- FEEDBACK COLLECTION ---
    match /feedback/{feedbackId} {
      allow create: if isSignedIn();
      allow read, update, delete: if isAdmin();
    }

    // --- SYSTEM SETTINGS COLLECTION ---
    match /system_settings/{settingId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // --- SOUNDS LIBRARY COLLECTION ---
    match /sounds/{soundId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // --- TRASH VAULT COLLECTION ---
    match /trash/{trashId} {
      allow read, write: if isAdmin();
    }

    // --- AD CAMPAIGNS COLLECTION ---
    match /ad_campaigns/{adId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update: if (isSignedIn() && (
        resource.data.creatorUid == request.auth.uid || 
        resource.data.userId == request.auth.uid || 
        isAdmin() ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'impressions', 'clicks', 'results', 'spent', 'updatedAt'
        ])
      )) || (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'impressions', 'clicks', 'results', 'spent', 'updatedAt'
        ])
      );
      allow delete: if isSignedIn() && (
        resource.data.creatorUid == request.auth.uid || 
        resource.data.userId == request.auth.uid || 
        isAdmin()
      );
    }

    // --- CHATS & MESSAGES COLLECTIONS ---
    match /conversations/{convId} {
      allow read, write: if isSignedIn();
      
      match /messages/{msgId} {
        allow read, write: if isSignedIn();
      }
    }

    match /groupChats/{groupId} {
      allow read: if isSignedIn() &&
        request.auth.uid in resource.data.participants;

      allow create: if isSignedIn() &&
        request.resource.data.createdBy == request.auth.uid &&
        request.auth.uid in request.resource.data.participants &&
        request.resource.data.participants is list &&
        request.resource.data.participants.size() >= 2 &&
        request.resource.data.name is string &&
        request.resource.data.name.size() > 0 &&
        request.resource.data.name.size() <= 80;

      allow update: if isSignedIn() &&
        request.auth.uid in resource.data.participants &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'lastMessage', 'lastMessageAt', 'updatedAt'
        ]) &&
        request.resource.data.lastMessage is string &&
        request.resource.data.lastMessageAt is timestamp;

      allow delete: if isSignedIn() &&
        resource.data.createdBy == request.auth.uid;

      match /messages/{messageId} {
        function isGroupMember() {
          return isSignedIn() &&
            request.auth.uid in get(
              /databases/$(database)/documents/groupChats/$(groupId)
            ).data.participants;
        }

        allow read: if isGroupMember();
        allow create: if isGroupMember() &&
          request.resource.data.senderId == request.auth.uid &&
          request.resource.data.text is string;
        allow update: if isGroupMember() &&
          resource.data.senderId == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'text', 'editedAt'
          ]) &&
          request.resource.data.text is string &&
          request.resource.data.editedAt is timestamp;
        allow delete: if isGroupMember() &&
          resource.data.senderId == request.auth.uid;
      }
    }

    match /users/{uid}/pocketMessages/{messageId} {
      allow read, create, update, delete: if isOwner(uid);
    }

    match /chats/{chatId} {
      allow read: if isSignedIn() &&
        (resource.data.senderId == request.auth.uid ||
         resource.data.receiverId == request.auth.uid);

      allow create: if isSignedIn() &&
        request.resource.data.senderId == request.auth.uid &&
        request.resource.data.receiverId is string &&
        request.resource.data.receiverId != request.auth.uid;

      allow update: if isSignedIn() && (
        (
          resource.data.receiverId == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']) &&
          request.resource.data.read == true
        ) ||
        (
          resource.data.senderId == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'editedAt']) &&
          request.resource.data.text is string &&
          request.resource.data.editedAt is timestamp
        )
      );

      allow delete: if isSignedIn() &&
        (resource.data.senderId == request.auth.uid ||
         resource.data.receiverId == request.auth.uid);
    }

    // --- PLAYLISTS & SOUND TRACKS ---
    match /playlists/{playlistId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /sound_tracks/{trackId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // --- COMMUNITY POSTS & POLLS COLLECTION ---
    match /posts/{postId} {
      allow read: if true;
      allow create: if isSignedIn() || (
        request.resource.data.authorId is string && 
        request.resource.data.authorId.size() > 0
      );
      allow update: if true;
      allow delete: if isSignedIn() && (
        resource.data.authorId == request.auth.uid || 
        resource.data.userId == request.auth.uid || 
        isAdmin()
      );

      match /comments/{commentId} {
        allow read: if true;
        allow create: if isSignedIn() || (
          request.resource.data.authorId is string || 
          request.resource.data.uid is string
        );
        allow update, delete: if true;
      }
    }

    // --- NOTIFICATIONS COLLECTION ---
    match /notifications/{notifId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }
  }
}
